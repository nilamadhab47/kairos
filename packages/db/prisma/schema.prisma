// Kairo Prisma schema \u2014 mirrors the SQL schema in KAIRO_TECH_SPEC.md \u00a77.
// All 10 tables: users, user_subscriptions, events, user_events, notifications,
// notification_preferences, habits, habit_completions, connected_sources, ai_copy_cache.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// USERS
// ============================================
model User {
  id             String   @id @default(uuid()) @db.Uuid
  email          String   @unique @db.VarChar(255)
  name           String?  @db.VarChar(255)
  avatarUrl      String?  @map("avatar_url")
  timezone       String   @default("Asia/Kolkata") @db.VarChar(50)
  googleToken    Json?    @map("google_token")
  onboardingDone Boolean  @default(false) @map("onboarding_done")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  subscriptions          UserSubscription[]
  userEvents             UserEvent[]
  notifications          Notification[]
  notificationPreference NotificationPreference?
  habits                 Habit[]
  connectedSources       ConnectedSource[]

  @@map("users")
}

// ============================================
// SUBSCRIPTIONS (sports/teams the user follows)
// ============================================
model UserSubscription {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  category   String   @db.VarChar(20) // football | f1 | cricket | tennis
  entityType String   @map("entity_type") @db.VarChar(20) // team | league | series | driver
  entityId   String   @map("entity_id") @db.VarChar(100) // external API ID
  entityName String   @map("entity_name") @db.VarChar(255)
  entityMeta Json?    @map("entity_meta") // logo_url, colors, abbreviation
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category, entityId])
  @@index([userId], name: "idx_subs_user")
  @@map("user_subscriptions")
}

// ============================================
// EVENTS (normalized from all sources)
// ============================================
model Event {
  id            String    @id @default(uuid()) @db.Uuid
  source        String    @db.VarChar(20) // football | f1 | calendar | youtube | habit
  category      String    @db.VarChar(20)
  sourceEventId String?   @map("source_event_id") @db.VarChar(255)
  title         String    @db.VarChar(500)
  subtitle      String?   @db.VarChar(500)
  startsAt      DateTime  @map("starts_at") @db.Timestamptz(6)
  endsAt        DateTime? @map("ends_at") @db.Timestamptz(6)
  status        String    @default("upcoming") @db.VarChar(20) // upcoming | live | completed | cancelled
  metadata      Json      @default("{}")
  contextTags   String[]  @default([]) @map("context_tags")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  userEvents    UserEvent[]
  notifications Notification[]
  aiCopyCache   AiCopyCache[]

  @@unique([source, sourceEventId])
  @@index([startsAt], name: "idx_events_starts")
  @@index([status], name: "idx_events_status")
  @@index([source], name: "idx_events_source")
  @@index([contextTags], name: "idx_events_tags", type: Gin)
  @@map("events")
}

// ============================================
// USER_EVENTS (which events belong to which user)
// ============================================
model UserEvent {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  eventId      String   @map("event_id") @db.Uuid
  isDismissed  Boolean  @default(false) @map("is_dismissed")
  isStarred    Boolean  @default(false) @map("is_starred")
  reminderSent Boolean  @default(false) @map("reminder_sent")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId])
  @@index([userId, eventId], name: "idx_ue_user_event")
  @@index([userId], name: "idx_ue_upcoming")
  @@map("user_events")
}

// ============================================
// NOTIFICATIONS
// ============================================
model Notification {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  eventId       String?   @map("event_id") @db.Uuid
  type          String    @db.VarChar(20) // morning_brief | pre_event | live_now | habit
  channel       String    @db.VarChar(20) // whatsapp | push | telegram
  title         String    @db.VarChar(255)
  body          String?   @db.Text
  aiGenerated   Boolean   @default(false) @map("ai_generated")
  status        String    @default("pending") @db.VarChar(20) // pending | sent | failed | read
  scheduledFor  DateTime  @map("scheduled_for") @db.Timestamptz(6)
  sentAt        DateTime? @map("sent_at") @db.Timestamptz(6)
  readAt        DateTime? @map("read_at") @db.Timestamptz(6)
  errorMsg      String?   @map("error_msg") @db.Text
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  event Event? @relation(fields: [eventId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt(sort: Desc)], name: "idx_notif_user")
  @@index([scheduledFor], name: "idx_notif_scheduled")
  @@index([status], name: "idx_notif_status")
  @@map("notifications")
}

// ============================================
// NOTIFICATION PREFERENCES
// ============================================
model NotificationPreference {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @unique @map("user_id") @db.Uuid
  channels      Json     @default("{\"whatsapp\": true, \"push\": true, \"telegram\": false}")
  briefTime     DateTime @default(dbgenerated("'08:00'::time")) @map("brief_time") @db.Time(6)
  maxDailyPush  Int      @default(4) @map("max_daily_push")
  dndStart      DateTime @default(dbgenerated("'23:00'::time")) @map("dnd_start") @db.Time(6)
  dndEnd        DateTime @default(dbgenerated("'07:00'::time")) @map("dnd_end") @db.Time(6)
  preEventMins  Int      @default(15) @map("pre_event_mins")
  categoryPrefs Json     @default("{}") @map("category_prefs")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

// ============================================
// HABITS
// ============================================
model Habit {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  title          String   @db.VarChar(255)
  scheduledTime  DateTime @map("scheduled_time") @db.Time(6)
  durationMins   Int      @default(10) @map("duration_mins")
  frequency      String   @default("daily") @db.VarChar(20) // daily | weekdays | weekends | custom
  frequencyDays  Int[]    @default([1, 2, 3, 4, 5, 6, 7]) @map("frequency_days")
  currentStreak  Int      @default(0) @map("current_streak")
  longestStreak  Int      @default(0) @map("longest_streak")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  completions HabitCompletion[]

  @@index([userId], name: "idx_habits_user")
  @@map("habits")
}

// ============================================
// HABIT COMPLETIONS
// ============================================
model HabitCompletion {
  id            String   @id @default(uuid()) @db.Uuid
  habitId       String   @map("habit_id") @db.Uuid
  completedDate DateTime @map("completed_date") @db.Date
  completedAt   DateTime @default(now()) @map("completed_at") @db.Timestamptz(6)

  habit Habit @relation(fields: [habitId], references: [id], onDelete: Cascade)

  @@unique([habitId, completedDate])
  @@index([habitId, completedDate(sort: Desc)], name: "idx_hc_habit")
  @@map("habit_completions")
}

// ============================================
// CONNECTED SOURCES
// ============================================
model ConnectedSource {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  sourceType    String    @map("source_type") @db.VarChar(20) // google_calendar | youtube | whatsapp
  credentials   Json?
  config        Json      @default("{}")
  isActive      Boolean   @default(true) @map("is_active")
  lastSyncedAt  DateTime? @map("last_synced_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, sourceType])
  @@map("connected_sources")
}

// ============================================
// AI COPY CACHE
// ============================================
model AiCopyCache {
  id          String   @id @default(uuid()) @db.Uuid
  eventId     String   @map("event_id") @db.Uuid
  notifType   String   @map("notif_type") @db.VarChar(20) // pre_event | live_now
  copyText    String   @map("copy_text") @db.VarChar(255)
  contextHash String   @map("context_hash") @db.VarChar(64)
  expiresAt   DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, notifType, contextHash])
  @@index([expiresAt], name: "idx_cache_expiry")
  @@map("ai_copy_cache")
}
