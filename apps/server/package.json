{
  "name": "@kairo/server",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "echo \"(no lint configured)\"",
    "seed:sports": "tsx ../../packages/db/seed/sports.ts",
    "backfill:competitions": "tsx ../../packages/db/scripts/backfill-competitions.ts",
    "backfill:cricket-teams": "tsx ../../packages/db/scripts/backfill-cricket-teams.ts",
    "backfill:f1-constructors": "tsx ../../packages/db/scripts/backfill-f1-constructors.ts",
    "backfill:competition-country": "tsx ../../packages/db/scripts/backfill-competition-country.ts",
    "wipe:user-data": "tsx ../../packages/db/scripts/wipe-user-data.ts",
    "report:logo-coverage": "tsx ../../packages/db/scripts/logo-coverage.ts"
  },
  "dependencies": {
    "@better-auth/core": "1.6.26",
    "@better-auth/utils": "0.4.2",
    "@fastify/cors": "^10.0.1",
    "@fastify/sensible": "^6.0.1",
    "@fastify/swagger": "^9.8.1",
    "@kairo/core": "workspace:*",
    "@kairo/db": "workspace:*",
    "@kairo/queue": "workspace:*",
    "@kairo/sports": "workspace:*",
    "@scalar/fastify-api-reference": "^1.64.1",
    "better-auth": "^1.3.4",
    "dotenv": "^16.4.5",
    "fastify": "^5.1.0",
    "tsx": "^4.19.1",
    "fastify-plugin": "^6.0.0",
    "pino-pretty": "^11.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "typescript": "^5.6.3"
  }
}
