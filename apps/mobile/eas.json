{
  "cli": {
    "version": ">= 13.2.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "pnpm": "9.12.0",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "http://10.0.2.2:4000",
        "NODE_ENV": "development"
      }
    },
    "development:device": {
      "extends": "development",
      "env": {
        "EXPO_PUBLIC_API_URL": "http://192.168.1.5:4000",
        "NODE_ENV": "development"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "pnpm": "9.12.0",
      "ios": { "simulator": false },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://preview-api.kairo.app"
      }
    },
    "production": {
      "channel": "production",
      "autoIncrement": true,
      "pnpm": "9.12.0",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.kairo.app"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
