# ============================================
# Kairo — .env.example
# Copy to .env at repo root for local dev
# ============================================
#
# VERIFY checklist (keys you already provided → must be non-empty in .env):
#   [ ] GOOGLE_CLIENT_ID
#   [ ] GOOGLE_CLIENT_SECRET
#   [ ] API_FOOTBALL_KEY
#   [ ] CRICKETDATA_API_KEY
#   [ ] RAPIDAPI_KEY              (Cricbuzz + SportAPI7)
#   [ ] SPORTMONKS_API_TOKEN
#   [ ] SPORTS_GAME_ODDS_API_KEY  (evaluate; odds-focused)
#   [ ] OPEN_ROUTER_API_KEY
#   [ ] EAS_PROJECT_ID
#   [ ] BETTER_AUTH_SECRET   (min 32 chars — generate if still placeholder)
#   [ ] OPENF1_BASE_URL      (no secret; default below is fine)
#
# Do NOT commit real secrets. Keep them only in .env (gitignored).
# ============================================

NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:4000

DATABASE_URL=postgresql://kairo:kairo@localhost:5432/kairo?schema=public
REDIS_URL=redis://localhost:6379

# Better Auth (min 32 chars)
BETTER_AUTH_SECRET=replace-me-with-a-long-random-secret-at-least-32
# Public URL of the API (used for OAuth callbacks). On device testing use LAN IP.
BETTER_AUTH_URL=http://localhost:4000

# Google OAuth — use a Web application client (not Android-only)
# Redirect URI: {BETTER_AUTH_URL}/api/auth/callback/google
# Status: PROVIDED — paste your Web client id/secret into .env
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Apple Sign-In (optional until iOS App Store)
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_APP_BUNDLE_IDENTIFIER=app.kairo.mobile

# Comma-separated extra origins in production
CORS_ORIGINS=

# --- Sports ingest ---

# OpenF1: no API key required (free historical / schedule data)
# Status: PROVIDED (default URL is fine)
OPENF1_BASE_URL=https://api.openf1.org/v1

# API-Football (api-sports.io) — primary football provider
# Dashboard: https://dashboard.api-football.com/
# Status: PROVIDED — paste into .env
API_FOOTBALL_KEY=
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io

# Cricket — CricketData.org / CricAPI (lifetime free 100 hits/day)
# Signup: https://cricketdata.org/signup.aspx
# Status: PROVIDED — paste into .env
CRICKETDATA_API_KEY=
CRICKETDATA_BASE_URL=https://api.cricapi.com/v1

# RapidAPI key — shared across SportAPI7 (football/multi-sport) + Cricbuzz (cricket)
# Get from: https://rapidapi.com/developer/dashboard
# Status: PROVIDED — paste into .env (test/temp key OK for evaluation)
RAPIDAPI_KEY=

# Sportmonks — football (+ cricket on paid plans)
# Docs: https://docs.sportmonks.com/v3
# Status: PROVIDED — paste into .env (test/temp key OK for evaluation)
SPORTMONKS_API_TOKEN=

# SportsGameOdds — odds / betting markets (evaluate; may not be needed)
# Docs: https://sportsgameodds.com/docs
# Status: PROVIDED — paste into .env; skip if odds are out of scope
SPORTS_GAME_ODDS_API_KEY=

# TheSportsDB — metadata/logos/badges ($9/mo premium for full access)
# Docs: https://www.thesportsdb.com/documentation
# Free demo key "3" works for limited public data
THESPORTSDB_API_KEY=3

# Telegram bot (M4 notifications) — from @BotFather
# Status: NOT YET — defer until M4
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# --- Notifications ---
# Optional Expo access token (recommended for production push volume)
# https://expo.dev/accounts/[account]/settings/access-tokens
# Status: NOT YET — needed before real-device push volume
EXPO_ACCESS_TOKEN=

# --- AI copy (optional; templates used if unset) ---
# Status: OPEN_ROUTER PROVIDED — paste into .env; Anthropic optional
ANTHROPIC_API_KEY=
OPEN_ROUTER_API_KEY=

# --- WhatsApp later (Twilio) — not required for MVP push ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# --- Google Calendar sync later — separate OAuth client recommended ---
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=

# --- Observability (optional) ---
SENTRY_DSN=

# Mobile (Expo) — public vars
# Use Mac LAN IP when testing on a physical Android device
EXPO_PUBLIC_API_URL=http://localhost:4000

# From `eas init` (also set in apps/mobile/app.json extra.eas.projectId)
# Status: PROVIDED — paste into .env
EAS_PROJECT_ID=

SERVER_PORT=4000
WEB_PORT=3000
HOST=0.0.0.0
