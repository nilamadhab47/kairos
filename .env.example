# ============================================
# Kairo \u2014 .env.example
# Copy to .env at repo root for local dev
# ============================================

# ---------- Core ----------
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:4000

# ---------- Database (Postgres 16) ----------
DATABASE_URL=postgresql://kairo:kairo@localhost:5432/kairo?schema=public

# ---------- Redis ----------
REDIS_URL=redis://localhost:6379

# ---------- Auth ----------
JWT_SECRET=replace-me-with-a-long-random-string
JWT_EXPIRES_IN=30d

# Google OAuth (used for both mobile id_token verification and Calendar OAuth)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Mobile OAuth client IDs (optional \u2014 platform-specific clients from Google Cloud)
GOOGLE_IOS_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_WEB_CLIENT_ID=

# ---------- AI ----------
ANTHROPIC_API_KEY=

# ---------- External sport APIs ----------
API_FOOTBALL_KEY=
OPENF1_BASE_URL=https://api.openf1.org/v1
CRICAPI_KEY=
YOUTUBE_API_KEY=

# ---------- Notification delivery ----------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=
TELEGRAM_BOT_TOKEN=

# Expo push (server-side delivery via Expo Push API)
EXPO_ACCESS_TOKEN=

# ---------- Mobile (Expo) ----------
# Public env vars exposed to the Expo client \u2014 must be prefixed EXPO_PUBLIC_
EXPO_PUBLIC_API_URL=http://localhost:4000
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# EAS / Expo project
EAS_PROJECT_ID=

# ---------- Server ports ----------
SERVER_PORT=4000
WEB_PORT=3000
