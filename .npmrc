# pnpm config for the Kairo monorepo (Expo SDK 52).
# Hoisted linker is required for Android autolinking — isolated pnpm installs
# generate a broken PackageList (`expo.core.ExpoModulesPackage`).
# See: https://github.com/expo/eas-cli/issues/2789
node-linker=hoisted
shamefully-hoist=false

auto-install-peers=false
strict-peer-dependencies=false

public-hoist-pattern[]=*expo*
public-hoist-pattern[]=*expo-modules-core*
public-hoist-pattern[]=*expo-modules-autolinking*
public-hoist-pattern[]=*babel-preset-expo*
public-hoist-pattern[]=*react-native*
public-hoist-pattern[]=*@react-native*
public-hoist-pattern[]=*metro*
public-hoist-pattern[]=*nativewind*
public-hoist-pattern[]=*tailwindcss*
public-hoist-pattern[]=*@types*
