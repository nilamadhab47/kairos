# pnpm config for the Kairo monorepo.
# Expo SDK 52 + RN 0.76 use isolated installs; we keep node-linker=isolated
# (pnpm default) so each workspace gets its own React/RN copy.
auto-install-peers=true
strict-peer-dependencies=false

# Hoist a few patterns Expo / Metro insist on resolving from the top level.
public-hoist-pattern[]=*expo*
public-hoist-pattern[]=*react-native*
public-hoist-pattern[]=*@react-native*
public-hoist-pattern[]=*metro*
public-hoist-pattern[]=*nativewind*
public-hoist-pattern[]=*tailwindcss*
public-hoist-pattern[]=*@types*

# Required by Prisma + native modules in some monorepo setups.
node-linker=isolated
shamefully-hoist=false
